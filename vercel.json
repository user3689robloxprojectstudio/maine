{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/verify/(.*)", "destination": "/api" },
    { "source": "/H.jpg", "destination": "/api" },
    { "source": "/favicon.ico", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "scripts/**,public/**"
    }
  }
}
